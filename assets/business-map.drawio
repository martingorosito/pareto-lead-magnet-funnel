undColor=#FFFFFF;" edge="1" parent="1" source="book" target="bk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="books" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#070C10;strokeWidth=2;fontSize=10;fontColor=#070C10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bk" target="bwf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="doesn&#x27;t book" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#070C10;strokeWidth=2;fontSize=10;fontColor=#070C10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="bk" target="fu"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="nudges to book" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=2;fontSize=10;fontColor=#070C10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="fu" target="book"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="redirect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=2;fontSize=10;fontColor=#070C10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="bwf" target="booked"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#070C10;strokeWidth=2;fontSize=10;fontColor=#070C10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bwf" target="call"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="no-show" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#070C10;strokeWidth=2;fontSize=10;fontColor=#070C10;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="call" target="ns"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="signs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#070C10;strokeWidth=2;fontSize=10;fontColor=#070C10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="call" target="cl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="doesn&#x27;t sign" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#070C10;strokeWidth=2;fontSize=10;fontColor=#070C10;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="call" target="nsg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="comes back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=2;fontSize=10;fontColor=#070C10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="nsg" target="ro"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#070C10;strokeWidth=2;fontSize=10;fontColor=#070C10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cl" target="client"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="rebook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=2;fontSize=10;fontColor=#070C10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ns" target="book"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#070C10;strokeWidth=2;fontSize=10;fontColor=#070C10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="thx" target="nur"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="button" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=2;fontSize=10;fontColor=#070C10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="thx" target="auditr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="Nurture 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=2;fontSize=10;fontColor=#070C10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="nur" target="auditr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="re-invite when ready" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=2;fontSize=10;fontColor=#070C10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="nur" target="book"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pipe" value="&lt;b&gt;Pipeline (L11): FP | Martin Gorosito | Right Hand Pipeline&lt;/b&gt;&lt;br&gt;1. Opted In: submitted the form&lt;br&gt;2. Qualified: passed all 5, not booked yet&lt;br&gt;3. Call Booked: booked the Fit Call&lt;br&gt;4. Client: signed (also marked Won)&lt;br&gt;5. Unqualified: in nurture, kept&lt;br&gt;Didn&#x27;t sign: built-in status Lost or Abandoned&lt;br&gt;(shared account blocks adding a sixth stage)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;align=left;verticalAlign=top;spacing=10;fontColor=#070C10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="300" height="170" as="geometry"/></mxCell><mxCell id="crit" value="&lt;b&gt;Qualified = all 5&lt;/b&gt;&lt;br&gt;Founder or decision maker&lt;br&gt;$500K+ a year in revenue&lt;br&gt;Based in the US&lt;br&gt;OK with $3,600 a month&lt;br&gt;Wants help within 3 months" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;align=left;verticalAlign=top;spacing=10;fontColor=#070C10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="90" width="220" height="170" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;White box: page or asset (click to open)&lt;br&gt;Green box: GHL workflow (screenshots in L12)&lt;br&gt;Dark diamond: decision&lt;br&gt;Grey dashed box: gap, Pareto&#x27;s own process&lt;br&gt;Solid arrow: the founder moves on&lt;br&gt;Dashed arrow: email, redirect or re-invite" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;align=left;verticalAlign=top;spacing=10;fontColor=#070C10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="90" width="300" height="170" as="geometry"/></mxCell><mxCell id="gaps" value="&lt;b&gt;Gaps, marked honestly&lt;/b&gt;&lt;br&gt;1. Ads are finished creatives, not live campaigns&lt;br&gt;2. No Meta Pixel, CAPI or GA4 yet&lt;br&gt;3. Call and Client stages are Pareto&#x27;s process&lt;br&gt;4. Site on a preview domain (vibepreview.app)&lt;br&gt;5. Shared GHL account: pipeline locked, sending limit hit Oct 6&lt;br&gt;6. No-shows are marked by hand&lt;br&gt;7. No SMS (needs A2P registration)&lt;br&gt;8. No re-engagement after nurture yet&lt;br&gt;9. Tested with test contacts only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;align=left;verticalAlign=top;spacing=10;fontColor=#070C10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="420" height="220" as="geometry"/></mxCell><mxCell id="test" value="&lt;b&gt;Tested end to end, Oct 5-6&lt;/b&gt;&lt;br&gt;All pages open logged out&lt;br&gt;Qualified: /book → booked → /booked → Call Booked, left follow-up&lt;br&gt;Unqualified: /thanks, 2A and 2B branches → nurture-complete&lt;br&gt;No-show, signed, not signed, reopened: each tagged correctly" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;align=left;verticalAlign=top;spacing=10;fontColor=#070C10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="760" width="460" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>