<mxfile host="app.diagrams.net"><diagram id="map" name="Business Map"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2760" pageHeight="1180" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="FP | Martin Gorosito | Business Map: The Founder&#x27;s Bottleneck Audit (as built, updated Oct 6, 2026)" style="text;html=1;align=left;fontSize=20;fontStyle=1;fontColor=#070C10;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry"/></mxCell><mxCell id="sub" value="Live site: https://fp-martin-gorosito.vibepreview.app  ·  CRM: GoHighLevel  ·  Click a box with a link to open the live asset" style="text;html=1;align=left;fontSize=12;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1400" height="24" as="geometry"/></mxCell><UserObject label="&lt;b&gt;1 · Facebook ads (5)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;One per persona, button Learn More&lt;br&gt;Link: L13 Drive folder&lt;br&gt;Stage: none&lt;/span&gt;" link="https://drive.google.com/drive/folders/1TwOJYmAgbu3bTNMb824TEi7BDuS4ytqy" id="ads"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=2;fontColor=#070C10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="240" height="120" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;2 · Landing page + qualifying form&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;/ with the GHL survey embedded&lt;br&gt;Link: L7, L8&lt;br&gt;Stage: Opted In on submit&lt;/span&gt;" link="https://fp-martin-gorosito.vibepreview.app/" id="land"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=2;fontColor=#070C10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="520" width="240" height="120" as="geometry"/></mxCell></UserObject><mxCell id="optin" value="&lt;b&gt;3 · ① Opt-in Workflow&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Tag fp-mg-lead-magnet-audit&lt;br&gt;Opportunity in Opted In ($3,600)&lt;br&gt;Notify Martin · If/Else on 5 answers&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;strokeWidth=2;fontColor=#070C10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="520" width="240" height="120" as="geometry"/></mxCell><mxCell id="q" value="All 5 answers pass?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#070C10;strokeColor=#10B981;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="525" width="160" height="110" as="geometry"/></mxCell><UserObject label="&lt;b&gt;L6 · Audit, qualified version&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;/audit, with booking button&lt;br&gt;Sent by Lead Magnet Delivery Email&lt;br&gt;Stage: none&lt;/span&gt;" link="https://fp-martin-gorosito.vibepreview.app/audit" id="audit"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=2;fontColor=#070C10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="40" width="240" height="120" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;4a · Booking page&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;/book, Right Hand Fit Call calendar&lt;br&gt;Link: L9&lt;br&gt;Stage: Qualified&lt;/span&gt;" link="https://fp-martin-gorosito.vibepreview.app/book" id="book"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=2;fontColor=#070C10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="200" width="240" height="120" as="geometry"/></mxCell></UserObject><mxCell id="bk" value="Booked a call?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#070C10;strokeColor=#10B981;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1370" y="205" width="150" height="110" as="geometry"/></mxCell><mxCell id="fu" value="&lt;b&gt;5a · ② Qualified Follow-up&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Follow-up Emails 1, 2, 3 (days 1, 3, 6)&lt;br&gt;&#x27;Booked yet?&#x27; check before each&lt;br&gt;Then nudge to Martin · Stage: Qualified&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;strokeWidth=2;fontColor=#070C10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1340" y="370" width="240" height="120" as="geometry"/></mxCell><UserObject label="&lt;b&gt;4a+ · Call booked page&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;/booked (calendar redirects here)&lt;br&gt;Confirms the call, links to /audit&lt;br&gt;Stage: Call Booked&lt;/span&gt;" link="https://fp-martin-gorosito.vibepreview.app/booked" id="booked"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=2;fontColor=#070C10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1600" y="40" width="240" height="120" as="geometry"/></mxCell></UserObject><mxCell id="bwf" value="&lt;b&gt;6 · ④ Booking Workflow&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Leaves ② and ③ · tag fp-mg-call-booked&lt;br&gt;Confirmation + 24 h and 1 h reminders&lt;br&gt;Stage: Call Booked&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;strokeWidth=2;fontColor=#070C10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1600" y="200" width="240" height="120" as="geometry"/></mxCell><mxCell id="call" value="&lt;b&gt;7 · Right Hand Fit Call&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;30 min with Pareto, reviews the audit&lt;br&gt;GAP: Pareto&#x27;s sales call&lt;br&gt;Stage: Call Booked&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;strokeWidth=2;dashed=1;fontColor=#374151;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1880" y="200" width="240" height="120" as="geometry"/></mxCell><mxCell id="ns" value="&lt;b&gt;8a · ⑤ No-show Follow-up&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Appointment marked No show&lt;br&gt;Tag fp-mg-call-no-show, back to Qualified&lt;br&gt;No-show email to rebook&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;strokeWidth=2;fontColor=#070C10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2180" y="40" width="240" height="120" as="geometry"/></mxCell><mxCell id="cl" value="&lt;b&gt;8b · ⑥ Client Tagging&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Stage Client or status Won&lt;br&gt;Tag fp-mg-client&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;strokeWidth=2;fontColor=#070C10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2180" y="200" width="240" height="100" as="geometry"/></mxCell><mxCell id="nsg" value="&lt;b&gt;8c · ⑦ Not Signed Tagging&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Status Lost or Abandoned&lt;br&gt;Tag fp-mg-call-not-signed&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;strokeWidth=2;fontColor=#070C10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2180" y="330" width="240" height="100" as="geometry"/></mxCell><mxCell id="ro" value="&lt;b&gt;8d · ⑧ Reopened Tagging&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Status back to Open&lt;br&gt;Removes fp-mg-call-not-signed&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;strokeWidth=2;fontColor=#070C10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2180" y="460" width="240" height="100" as="geometry"/></mxCell><mxCell id="client" value="&lt;b&gt;9 · Client&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Right Hand Program&lt;br&gt;GAP: Pareto&#x27;s matching&lt;br&gt;Stage: Client&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;strokeWidth=2;dashed=1;fontColor=#374151;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2460" y="200" width="240" height="100" as="geometry"/></mxCell><UserObject label="&lt;b&gt;4b · Thank-you page&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;/thanks: confirms, button to the audit&lt;br&gt;Never says &#x27;you don&#x27;t qualify&#x27;&lt;br&gt;Link: L10 · Stage: Unqualified&lt;/span&gt;" link="https://fp-martin-gorosito.vibepreview.app/thanks" id="thx"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=2;fontColor=#070C10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="840" width="240" height="120" as="geometry"/></mxCell></UserObject><mxCell id="nur" value="&lt;b&gt;5b · ③ Unqualified Nurture&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Nurture 1 at once (delivers the audit)&lt;br&gt;Day 2: 2A burned by a VA / 2B others&lt;br&gt;Day 5: Nurture 3 · tag nurture-complete&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;strokeWidth=2;fontColor=#070C10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1370" y="840" width="240" height="120" as="geometry"/></mxCell><UserObject label="&lt;b&gt;L6 · Audit, nurture version&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;/audit-results, no booking button&lt;br&gt;Sent by /thanks and Nurture Email 1&lt;br&gt;Stage: none&lt;/span&gt;" link="https://fp-martin-gorosito.vibepreview.app/audit-results" id="auditr"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=2;fontColor=#070C10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="1010" width="240" height="120" as="geometry"/></mxCell></UserObject><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#070C10;stro